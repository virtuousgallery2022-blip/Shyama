  <main>
    <section class="hero">
      <div class="container hero-shell">
        <div class="hero-left">
          <div class="hero-content">
            <span class="badge">Luxury Property Advisory</span>
            <h1 class="hero-title">Find Verified Property and Investment Opportunities</h1>
            <p class="hero-copy">Discover verified residences, plots, and growth-focused opportunities across premium locations.</p>
            <div class="hero-stats">
              <div class="hero-stat"><strong data-count-properties>18</strong><span>Properties</span></div>
              <div class="hero-stat"><strong data-count-investments>14</strong><span>Investments</span></div>
              <div class="hero-stat"><strong data-count-projects>14</strong><span>Project Docs</span></div>
            </div>
          </div>
        </div>

        <aside class="hero-right search-card">
          <h2>Search Property Listings</h2>
          <p>Search by city, type, budget, and requirement. Results open with premium listings first.</p>

          <div class="purpose-group" data-purpose-group>
            <button type="button" class="active" data-value="buy">Buy</button>
            <button type="button" data-value="rent">Rent</button>
          </div>

          <form id="homeSearchForm" class="search-form">
            <input type="hidden" name="purpose" value="buy" data-purpose-input>
            <div class="search-grid">
              <div class="field">
                <label for="homeCity">City</label>
                <select id="homeCity" name="city" data-city-select>
                  <option value="">Any city</option>
                </select>
              </div>
              <div class="field">
                <label for="homeType">Property Type</label>
                <select id="homeType" name="type" data-type-select>
                  <option value="">Any type</option>
                </select>
              </div>
            </div>
            <div class="search-grid">
              <div class="field">
                <label for="homeBudget">Budget</label>
                <select id="homeBudget" name="budget" data-property-budget-select>
                  <option value="">Any budget</option>
                  <option value="100-300">INR 1 Crore to 3 Crore</option>
                  <option value="300-500">INR 3 Crore to 5 Crore</option>
                  <option value="500-1000">INR 5 Crore to 10 Crore</option>
                </select>
              </div>
              <div class="field">
                <label for="homeKeyword">Keyword</label>
                <input id="homeKeyword" name="keyword" type="text" placeholder="Jagatpura, villa, plot">
              </div>
            </div>
            <button class="btn btn-solid" type="submit">Search Properties</button>
          </form>
          <div class="popular-searches">
            <span>Popular:</span>
            <a href="properties.html?city=Jaipur">Jaipur</a>
            <a href="properties.html?type=villa">Luxury Villas</a>
            <a href="properties.html?type=farm-land">Farm Land</a>
            <a href="investments.html">Investment Deals</a>
          </div>
        </aside>
      </div>
    </section>

    <section class="portal-shortcuts">
      <div class="container portal-shortcut-grid">
        <a href="properties.html?purpose=buy">
          <strong>Buy</strong>
          <span>Premium homes, plots, villas</span>
        </a>
        <a href="properties.html?purpose=rent">
          <strong>Rent</strong>
          <span>Luxury rentals from INR 1 Lakh</span>
        </a>
        <a href="projects.html">
          <strong>Projects</strong>
          <span>Brochures and project documents</span>
        </a>
        <a href="contact.html">
