          <strong>List Property</strong>
          <span>Share seller or landlord inventory</span>
        </a>
        <a href="contact.html">
          <strong>Consultant</strong>
          <span>Talk to Shyama advisor</span>
        </a>
      </div>
    </section>

    <section class="section latest-inventory-section">
      <div class="container">
        <div class="featured-head">
          <div>
            <span class="badge">Latest Inventory</span>
            <h2 class="section-title">Newly Added from the July Update</h2>
            <p class="section-subtitle">The newest verified listings appear here first, ordered from higher to lower asking value.</p>
          </div>
          <a class="btn btn-outline" href="properties.html?sort=newest">View All New Listings</a>
        </div>
        <div class="property-grid" data-latest-grid></div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="featured-head">
          <div>
            <span class="badge">Properties</span>
            <h2 class="section-title">Buy and Rent Listings</h2>
            <p class="section-subtitle">Handpicked buy and rent opportunities shown from higher value to lower value.</p>
          </div>
          <span class="saved-pill" data-saved-count>0 shortlisted | 0 compare</span>
          <div class="tab-row">
            <button type="button" class="active" data-featured-tab data-value="buy">Buy</button>
            <button type="button" data-featured-tab data-value="rent">Rent</button>
          </div>
        </div>
        <div class="property-grid" data-featured-grid></div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="featured-head">
          <div>
            <span class="badge">Investments</span>
            <h2 class="section-title">Growth and Yield Opportunities</h2>
            <p class="section-subtitle">Strategic opportunities designed for long-term growth and steady yield.</p>
          </div>
          <a class="btn btn-outline" href="investments.html">View All Investments</a>
        </div>
        <div class="property-grid" data-investment-grid></div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <span class="badge">Projects</span>
        <h2 class="section-title">Current Project Portfolio</h2>
        <div class="project-grid" data-project-grid data-limit="6"></div>
